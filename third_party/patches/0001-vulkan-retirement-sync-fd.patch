+int VkCompute::retire_device_lost()
+{
+    // The owning device coordinator supplies the all-queues quiescence proof.
+    // Do not restore pre-loss metadata: external contents/layout are undefined.
+    // Claim failed finalization before dropping records so neither an explicit
+    // retry nor the destructor can apply delayed host copies after the loss.
+    d->valid = false;
+    d->discarded = true;
+    d->uncertain_submit = true;
+    d->submission_state = 4;
+    d->finalize_status = -1;
+    d->pending_dispatch_total = 0;
+    d->release_record_payloads();
+    d->delayed_records.clear();
+    return 0;
+}
+int VkCompute::discard_unsubmitted() {
+    if (!d->retirement_managed || (d->submission_state != 0 && d->submission_state != 1)) return -1;
+    d->restore_record_state();
+    d->discarded = true;
+    return 0;
+}
+bool VkCompute::recording_allowed() const {
+    if (!d->valid || d->discarded || d->submission_state != 0) return false;
+    d->recording_started = true;
+    return true;
+}
 
