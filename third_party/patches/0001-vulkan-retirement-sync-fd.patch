+VkBatchTimestamp::~VkBatchTimestamp() { if (pool) vkDestroyQueryPool(device->vkdevice(), pool, 0); }
+int VkBatchTimestamp::configure(bool enabled)
+{
+    if (!enabled) return 0;
+    uint32_t count = 0; vkGetPhysicalDeviceQueueFamilyProperties(device->info.physicalDevice(), &count, 0);
+    std::vector<VkQueueFamilyProperties> queues(count);
+    if (count) vkGetPhysicalDeviceQueueFamilyProperties(device->info.physicalDevice(), &count, queues.data());
+    uint32_t family = device->info.compute_queue_family_index();
+    if (family >= count) return -1;
+    bits = queues[family].timestampValidBits;
+    period = device->info.physicalDeviceProperties().limits.timestampPeriod;
+    memcpy(&period_bits, &period, 4);
+    if (!bits || bits > 64 || (period_bits & 0x80000000u) || (period_bits & 0x7f800000u) == 0x7f800000u || !(period_bits & 0x7fffffffu)) return -1;
+    if (pool) return 0;
+    VkQueryPoolCreateInfo q = {}; q.sType = VK_STRUCTURE_TYPE_QUERY_POOL_CREATE_INFO;
+    q.queryType = VK_QUERY_TYPE_TIMESTAMP; q.queryCount = 2;
+    return vkCreateQueryPool(device->vkdevice(), &q, 0, &pool) == VK_SUCCESS ? 0 : -1;
+}
+void VkBatchTimestamp::begin(VkCommandBuffer command)
+{
+    elapsed = 0; observed = false;
+    if (pool) { vkCmdResetQueryPool(command, pool, 0, 2); vkCmdWriteTimestamp(command, VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT, pool, 0); }
+}
+void VkBatchTimestamp::end(VkCommandBuffer command) { if (pool) vkCmdWriteTimestamp(command, VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT, pool, 1); }
+void VkBatchTimestamp::submitted() { if (pool) submit_wall = std::chrono::steady_clock::now(); }
+void VkBatchTimestamp::retired()
+{
+    observed = false; elapsed = 0;
+    if (!pool || !bits) return;
+    struct Value { uint64_t ticks, available; } values[2] = {};
+    VkResult status = vkGetQueryPoolResults(device->vkdevice(), pool, 0, 2, sizeof(values), values, sizeof(Value), VK_QUERY_RESULT_64_BIT | VK_QUERY_RESULT_WITH_AVAILABILITY_BIT);
+    if (status != VK_SUCCESS || !values[0].available || !values[1].available) return;
+    const uint64_t mask = bits == 64 ? UINT64_MAX : (uint64_t(1) << bits) - 1;
+    // CPU wall is only a conservative wrap-ambiguity guard, never GPU elapsed.
+    if (bits < 64) {
+        long double wrap_ns = (static_cast<long double>(mask) + 1) * period;
+        auto upper_bound = std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now() - submit_wall).count();
+        if (upper_bound < 0 || static_cast<long double>(upper_bound) >= wrap_ns) return;
+    }
+    uint64_t ticks = ((values[1].ticks & mask) - (values[0].ticks & mask)) & mask;
+    long double ns = static_cast<long double>(ticks) * period;
+    if (ns < 0 || ns >= static_cast<long double>(UINT64_MAX)) return;
+    elapsed = static_cast<uint64_t>(ns); observed = true;
+}
+void VkBatchTimestamp::result(uint64_t* ns, uint32_t* valid, uint32_t* valid_bits, uint32_t* pbits) const
+{ *ns = elapsed; *valid = observed ? 1 : 0; *valid_bits = bits; *pbits = period_bits; }
