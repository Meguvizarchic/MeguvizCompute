function(mgc_read_ncnn_layer_names output)
  file(STRINGS "${MGC_NCNN_SOURCE}/src/CMakeLists.txt" declarations REGEX "^[ \t]*ncnn_add_layer\\(")
  foreach(declaration IN LISTS declarations)
    if(NOT declaration MATCHES "^[ \t]*ncnn_add_layer\\(([A-Za-z][A-Za-z0-9_]*)([ \t]+(ON|OFF))?\\)[ \t]*$")
      message(FATAL_ERROR "Unrecognized pinned ncnn layer declaration: ${declaration}")
    endif()
    string(TOLOWER "${CMAKE_MATCH_1}" name)
    if(name IN_LIST names)
      message(FATAL_ERROR "Duplicate pinned ncnn layer: ${name}")
    endif()
    list(APPEND names "${name}")
  endforeach()
  if(NOT names)
    message(FATAL_ERROR "Pinned ncnn layer declarations are missing")
  endif()
  list(SORT names)
  set(${output} "${names}" PARENT_SCOPE)
endfunction()

function(mgc_read_ncnn_layer_manifest output known_names)
  file(READ "${MGC_NCNN_LAYER_MANIFEST}" manifest)
  string(JSON schema GET "${manifest}" schema_version)
  string(JSON commit GET "${manifest}" ncnn_commit)
  string(JSON graph_sha GET "${manifest}" model_graph_sha256)
  string(LENGTH "${graph_sha}" graph_sha_length)
  if(NOT schema STREQUAL "1" OR NOT commit STREQUAL MGC_NCNN_COMMIT OR
     NOT graph_sha_length EQUAL 64 OR NOT graph_sha MATCHES "^[0-9a-f]+$")
    message(FATAL_ERROR "ncnn layer manifest schema, pinned revision or model hash is invalid")
  endif()
  string(JSON layer_count LENGTH "${manifest}" layers)
  list(LENGTH known_names known_count)
  if(layer_count LESS 1 OR layer_count GREATER known_count)
    message(FATAL_ERROR "ncnn layer manifest has an invalid layer count")
  endif()
  math(EXPR last_layer "${layer_count} - 1")
  foreach(index RANGE ${last_layer})
    string(JSON name GET "${manifest}" layers ${index})
    if(NOT name IN_LIST known_names OR name IN_LIST selected)
      message(FATAL_ERROR "Unknown or duplicate ncnn layer in manifest: ${name}")
    endif()
    list(APPEND selected "${name}")
  endforeach()
  set(${output} "${selected}" PARENT_SCOPE)
endfunction()
